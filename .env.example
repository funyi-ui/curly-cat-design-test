# Copy to .env. Real values belong only in the ignored .env file.
APP_ORIGIN=http://127.0.0.1:5173
PORT=5173
NODE_ENV=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase PostgreSQL session pooler URL; URI-encode special characters in the DB password.
# Obtain the exact SSL configuration from the Connect panel. Keep TLS verification enabled.
DATABASE_URL=
# Generate with the command in backend/README.md. At least 48 random characters.
SESSION_SECRET=

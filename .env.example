# Copy to ignored .env and fill values locally. Never share actual values in chat or logs.
# Local website origin, without trailing slash. For this project use http://127.0.0.1:5173.
APP_ORIGIN=
# Local server port. For this project use 5173.
PORT=
# Local environment: development. Production requires HTTPS and further deployment review.
NODE_ENV=
# Project URL: Supabase project Connect panel (API) or Settings > Data API.
SUPABASE_URL=
# Publishable key: Settings > API Keys. Legacy anon key also supported. Never use secret/service_role.
SUPABASE_PUBLISHABLE_KEY=
# PostgreSQL session pooler URI: project Connect > connection string > Session pooler.
# Enter the DB password locally and URI-encode special characters. Keep TLS certificate verification.
DATABASE_URL=
# Local random session secret, at least 48 characters. Generate directly into .env; do not print it.
SESSION_SECRET=
